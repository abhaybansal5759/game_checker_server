# Copy this to .env and fill in values for local development
# Never commit .env to git

# Server
PORT=8080

# MongoDB - use your Atlas free-tier connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=checkers

# JWT - generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Firebase (optional - skip if not using Google login)
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Bot
BOT_DEPTH=4

# Rate limiting (tokens per second)
RATE_PER_SEC=10
RATE_BURST=30
AUTH_RATE_PER_SEC=2
AUTH_BURST=5
WS_RATE_PER_SEC=5
WS_BURST=10